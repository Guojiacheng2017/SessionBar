{
  "name": "sessionbar",
  "version": "1.1.0",
  "description": "Terminal dashboard for AI CLI agent sessions — Claude Code, Gemini CLI, Codex, Copilot",
  "type": "module",
  "bin": {
    "sessionbar": "./dist/cli/cli.js"
  },
  "files": [
    "dist/",
    "public/",
    "docs/images/",
    "docs/licenses/",
    "docs/THIRD_PARTY_NOTICES.md",
    "docs/harness-input-adapters.md",
    "docs/relay-runtime.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "report.sh"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:css && tsc",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/web/tailwind.css -o public/tailwind.css --minify",
    "prestart": "npm run build",
    "start": "node dist/cli/cli.js",
    "prepack": "npm run build",
    "test": "npm run build && node --import ./test/isolateEnvironment.mjs --test test/*.test.mjs"
  },
  "dependencies": {
    "@opentui/core": "^0.4.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "smol-toml": "^1.9.1",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "cli",
    "terminal",
    "tui",
    "ai",
    "monitor",
    "dashboard"
  ],
  "license": "MIT"
}
